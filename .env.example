# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# --- Supabase Postgres -------------------------------------------------------
# Get it from Supabase Studio > Connect (top bar) > "Direct connection" / Session pooler.
# From inside the namsventure container, "localhost" is the container itself, so use
# host.docker.internal (docker-compose maps it to your server) instead of localhost.
#
# Self-hosted via Supavisor (default in recent Supabase self-host):
#   postgresql://postgres.YOUR_TENANT_ID:YOUR_POSTGRES_PASSWORD@host.docker.internal:5432/postgres
# Or, if this container joins the Supabase docker network (see docker-compose.yml):
#   postgresql://postgres:YOUR_POSTGRES_PASSWORD@supabase-db:5432/postgres
#
# Special characters in the password (@ : / # ?) must be URL-encoded.
DATABASE_URL='postgresql://postgres.supatenant:2a94a545ecbfb78f5d9a660f977134bf@100.106.235.121:55005/postgres'
DATABASE_SSL=false
# DATABASE_URL=postgresql://postgres.supatenant:2a94a545ecbfb78f5d9a660f977134bf@host.docker.internal:55005/postgres

# --- Telemetry panel at /admin ----------------------------------------------
ADMIN_PASSWORD=H6e9nfrmb3#
# Random string used to anonymise visitor IDs. Run: openssl rand -hex 32
ANALYTICS_SALT=d4e55e2fd8aa1e136b95ce7e7fe8f7f7c875e21e26aa002c1ffd61d528e0f0b9

# --- Search engine verification (optional) ----------------------------------
# Google Search Console > Add property > HTML tag > copy only the content="..." value
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML meta tag > content value
BING_SITE_VERIFICATION=

# --- Google rankings in /admin (optional) -----------------------------------
# 1. Verify the site in Search Console (GOOGLE_SITE_VERIFICATION above), submit /sitemap.xml
# 2. console.cloud.google.com > new project > enable "Google Search Console API"
#    > IAM > Service accounts > create > Keys > Add key > JSON (downloads a file)
# 3. Search Console > Settings > Users and permissions > Add user:
#    the service account's email, permission "Restricted"
# 4. Copy from the JSON file: client_email and private_key (keep it in quotes, \n and all)
GSC_SITE_URL=sc-domain:namsventure.com
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# Your live domain is set in src/lib/site.ts (SITE.url). It's baked in at build
# time, so change it there, not here.
